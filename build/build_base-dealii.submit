#!/bin/bash


# Job resource directives
#SBATCH -J build_base-dealii
#SBATCH -A open
#SBATCH -p basic
#SBATCH -t 2:00:00
#SBATCH -N 1
#SBATCH -n 16
#SBATCH --mem 64G
#SBATCH -o slurm-%x-%j.out


####
#### NOTE: Observed build times vs. number of tasks used (-n directive)
####
####            n     time
####            16    ~70 min
####            24    ~60 min
####            
####


# Find base aspect-pipeline directory
TARGET_DIR_NAME="aspect-pipeline"
CURRENT_DIR=$(pwd -P)
REPO_BASE_DIR=""
while [[ "${CURRENT_DIR}" != "/" ]]; do
    if [[ "$(basename "${CURRENT_DIR}")" == "${TARGET_DIR_NAME}" ]]; then
        REPO_BASE_DIR="${CURRENT_DIR}"
        break
    fi
    CURRENT_DIR=$(dirname "${CURRENT_DIR}")
done


# Configuration information for definition file and container
BASENAME="base-dealii"                                          # base name of definition file
REPO_BASE_DIR=$(echo $(cd ..; pwd))                             # set base directory of pipeline
DEFINITION="${BASENAME}.def"                                    # definition filename
DEFINITION_FULL="${REPO_BASE_DIR}/definitions/${DEFINITION}"    # full path to definition file
TAG=""                                                          # differentiator, just leave blank to use BASENAME
TYPE="sif"                                                      # either "sb" (writable sandbox) or "sif" (image)"
CONTAINER="${BASENAME}${TAG}.${TYPE}"                           # container filename
CONTAINER_FULL="${REPO_BASE_DIR}/containers/${CONTAINER}"       # full path to container


# Specify ASPECT source code paths, if necessary
SRC_HOST=""
SRC_LOCAL=""

if [[ -z "${SRC_HOST}" && -z "${SRC_PATH}" ]]; then
    SRC_STATEMENT=""
    echo ""
    echo "No ASPECT source code paths are set. No external ASPECT source code will be used."
    echo ""
elif [[ -z "${SRC_HOST}" || -z "${SRC_LOCAL}" ]]; then
    echo ""
    if [[ ! -d "${SRC_HOST}" ]]; then echo "ERROR:  Host ASPECT source code path ${SRC_HOST} does not exist on host."; fi
    echo "ERROR:  If using ASPECT source code from host, both host and local (container) locations must be set properly."
    echo "        Verify that both or neither source code paths are set and that the host source code path exists on the host."
    echo ""
    exit 1;
else
    SRC_STATEMENT="--build-arg ASPECT_SRC_LOCAL=${SRC_LOCAL} --build-arg ASPECT_SRC_HOST=${SRC_HOST}"
    echo ""
    echo "ASPECT source code paths are set, using the following statement:  ${SRC_STATEMENT}"
    echo ""
fi


# Verify existence of definition file
if [[ ! -f "${DEFINITION_FULL}" ]]; then
    echo ""
    echo "Definition file ${DEFINITION_FULL} not found. Please verify its name and location."
    echo ""
    exit 1
fi


# Set container type
if [[ "${TYPE}" == "sb" ]]; then
    SANDBOX="s"
elif [[ "${TYPE}" == "sif" ]]; then
    SANDBOX=""
else
    echo ""
    echo "ERROR:  Failed to properly set container type (sandbox or image)."
    echo ""
    exit 1
fi


# Load MPI on host
module use /storage/group/tqm5707/default/stack/modules
module load intel/2025.3 mpi


# Build container
start_time=$(date +%s)
apptainer build -f${SANDBOX} --build-arg TASKS=${SLURM_NTASKS} ${SRC_STATEMENT} ${CONTAINER_FULL} ${DEFINITION_FULL}


if [ $? -eq 0 ]; then
    echo ""
    echo "  SUCCESS:  Container ${CONTAINER} built using definition file ${DEFINITION}."
    echo ""
    echo "                Definition location:  ${DEFINITION_FULL}"
    echo "                Container location:   ${CONTAINER_FULL}"
    echo ""
    echo ""
else
    echo ""
    echo "  FAILED:  Container build failed."
    echo ""
fi


# Determine build time
end_time=$(date +%s)
duration=$(( end_time - start_time ))
hours=$(( duration / 3600 ))
minutes=$(( ( duration % 3600 ) / 60 ))
seconds=$(( duration % 60 ))
echo "Build Duration: $hours hr, $minutes min, $seconds sec    ( $duration sec )  "

